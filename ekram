<script>
const firebaseConfig = { apiKey: "AIzaSyCiYlceOG4X1Zw1IdDy2xz3fIWuydYof3A", authDomain: "mistri-book.firebaseapp.com", projectId: "mistri-book", storageBucket: "mistri-book.firebasestorage.app", messagingSenderId: "387524929495", appId: "1:387524929495:web:e643a4f968306f259bcd92" };
console.log('Firebase loaded:', typeof firebase !== 'undefined' ? '✅ Yes' : '❌ No');
if (typeof firebase !== 'undefined') {
    firebase.initializeApp(firebaseConfig);
    const auth = firebase.auth();
    const db = firebase.firestore();
    db.settings({ merge: true });
    console.log('Firebase initialized successfully!');

    let currentUserRole = null, isLoggedIn = false, currentUserId = null;
    function showToast(msg, type='success') {
        const t = document.getElementById('toast');
        if(!t) return;
        t.textContent = msg;
        t.className = 'toast show ' + type;
        clearTimeout(t._timeout);
        t._timeout = setTimeout(() => t.classList.remove('show'), 3000);
    }
    function goToPage(id) {
        document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
        const el = document.getElementById(id);
        if(el) el.classList.add('active');
        document.getElementById('app-content').scrollTop = 0;
    }
    function updateNav(id) {
        document.querySelectorAll('#bottom-nav-user .nav-item, #bottom-nav-provider .nav-item').forEach(item => {
            item.classList.toggle('active', item.dataset.page === id);
        });
    }
    window.selectRole = function(role) {
        console.log('Role selected:', role);
        currentUserRole = role;
        goToPage(role === 'user' ? 'page-user-form' : 'page-provider-form');
    };
    window.showUserLogin = function(){ goToPage('page-user-login'); };
    window.showUserRegister = function(){ goToPage('page-user-form'); };
    window.registerUser = async function() {
        const name = document.getElementById('user-name').value.trim();
        const location = document.getElementById('user-location').value.trim();
        const phone = document.getElementById('user-phone').value.trim();
        if(!name || !location || !phone) { showToast('⚠️ সব তথ্য দিন!', 'error'); return; }
        const cleaned = phone.replace(/\D/g, '');
        if(cleaned.length < 11 || cleaned.length > 14) { showToast('❌ সঠিক নম্বর দিন', 'error'); return; }
        try {
            showToast('⏳ রেজিস্ট্রেশন হচ্ছে...', 'warning');
            const cred = firebase.auth.PhoneAuthProvider.credential('+88'+cleaned, '123456');
            const uc = await auth.signInWithCredential(cred);
            const uid = uc.user.uid;
            await db.collection('users').doc(uid).set({ uid, name, location, phone, wallet: 0, role: 'user', createdAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
            currentUserId = uid; currentUserRole = 'user'; isLoggedIn = true;
            showToast('✅ রেজিস্ট্রেশন সফল!', 'success');
            document.getElementById('bottom-nav-user').classList.add('show');
            document.getElementById('bottom-nav-provider').classList.remove('show');
            goToPage('page-user-home');
            updateNav('page-user-home');
        } catch(e) { console.error(e); showToast('❌ রেজিস্ট্রেশন ব্যর্থ', 'error'); }
    };
    window.loginUser = async function() {
        const phone = document.getElementById('user-login-phone').value.trim();
        const cleaned = phone.replace(/\D/g, '');
        if(cleaned.length < 11 || cleaned.length > 14) { showToast('❌ সঠিক নম্বর দিন', 'error'); return; }
        try {
            showToast('⏳ লগইন হচ্ছে...', 'warning');
            const cred = firebase.auth.PhoneAuthProvider.credential('+88'+cleaned, '123456');
            const uc = await auth.signInWithCredential(cred);
            const uid = uc.user.uid;
            const doc = await db.collection('users').doc(uid).get();
            if(!doc.exists) { showToast('❌ অ্যাকাউন্ট নেই!', 'error'); await auth.signOut(); return; }
            if(doc.data().role !== 'user') { showToast('❌ প্রোভাইডার অ্যাকাউন্ট!', 'error'); await auth.signOut(); return; }
            currentUserId = uid; currentUserRole = 'user'; isLoggedIn = true;
            showToast('✅ লগইন সফল!', 'success');
            document.getElementById('bottom-nav-user').classList.add('show');
            document.getElementById('bottom-nav-provider').classList.remove('show');
            goToPage('page-user-home');
            updateNav('page-user-home');
        } catch(e) { console.error(e); showToast('❌ লগইন ব্যর্থ', 'error'); }
    };
    window.showProviderLogin = function(){ goToPage('page-provider-login'); };
    window.showProviderRegister = function(){ goToPage('page-provider-form'); };
    window.registerProvider = async function() {
        const name = document.getElementById('provider-name').value.trim();
        const work = document.getElementById('provider-work').value.trim();
        const experience = parseInt(document.getElementById('provider-experience').value);
        const nid = document.getElementById('provider-nid').value.trim();
        const phone = document.getElementById('provider-phone').value.trim();
        if(!name || !work || !experience || !nid || !phone) { showToast('⚠️ সব তথ্য দিন!', 'error'); return; }
        const cleaned = phone.replace(/\D/g, '');
        if(cleaned.length < 11 || cleaned.length > 14) { showToast('❌ সঠিক নম্বর দিন', 'error'); return; }
        try {
            showToast('⏳ রেজিস্ট্রেশন হচ্ছে...', 'warning');
            const cred = firebase.auth.PhoneAuthProvider.credential('+88'+cleaned, '123456');
            const uc = await auth.signInWithCredential(cred);
            const uid = uc.user.uid;
            await db.collection('providers').doc(uid).set({ uid, name, work, experience, nid, phone, wallet: 0, role: 'provider', status: 'pending', rating: 0, totalOrders: 0, location: 'ঢাকা, মিরপুর', lat: 23.735, lng: 90.380, createdAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
            await db.collection('users').doc(uid).set({ uid, name, phone, role: 'provider', createdAt: firebase.firestore.FieldValue.serverTimestamp() }, { merge: true });
            currentUserId = uid; currentUserRole = 'provider'; isLoggedIn = true;
            showToast('✅ প্রোভাইডার রেজিস্ট্রেশন সফল! অনুমোদনের অপেক্ষায়', 'success');
            document.getElementById('bottom-nav-provider').classList.add('show');
            document.getElementById('bottom-nav-user').classList.remove('show');
            goToPage('page-provider-home');
            updateNav('page-provider-home');
        } catch(e) { console.error(e); showToast('❌ রেজিস্ট্রেশন ব্যর্থ', 'error'); }
    };
    window.loginProvider = async function() {
        const phone = document.getElementById('provider-login-phone').value.trim();
        const cleaned = phone.replace(/\D/g, '');
        if(cleaned.length < 11 || cleaned.length > 14) { showToast('❌ সঠিক নম্বর দিন', 'error'); return; }
        try {
            showToast('⏳ লগইন হচ্ছে...', 'warning');
            const cred = firebase.auth.PhoneAuthProvider.credential('+88'+cleaned, '123456');
            const uc = await auth.signInWithCredential(cred);
            const uid = uc.user.uid;
            const doc = await db.collection('providers').doc(uid).get();
            if(!doc.exists) { showToast('❌ অ্যাকাউন্ট নেই!', 'error'); await auth.signOut(); return; }
            const data = doc.data();
            if(data.status === 'pending') { showToast('⏳ অনুমোদনের অপেক্ষায়', 'warning'); await auth.signOut(); return; }
            if(data.status === 'rejected') { showToast('❌ প্রত্যাখ্যান', 'error'); await auth.signOut(); return; }
            currentUserId = uid; currentUserRole = 'provider'; isLoggedIn = true;
            showToast('✅ লগইন সফল!', 'success');
            document.getElementById('bottom-nav-provider').classList.add('show');
            document.getElementById('bottom-nav-user').classList.remove('show');
            goToPage('page-provider-home');
            updateNav('page-provider-home');
        } catch(e) { console.error(e); showToast('❌ লগইন ব্যর্থ', 'error'); }
    };
    window.logout = async function() {
        if(confirm('লগআউট?')) {
            await auth.signOut();
            isLoggedIn = false; currentUserRole = null; currentUserId = null;
            document.getElementById('bottom-nav-user').classList.remove('show');
            document.getElementById('bottom-nav-provider').classList.remove('show');
            showToast('✅ লগআউট সফল', 'success');
            goToPage('page-role');
        }
    };
    window.rechargeWallet = async function() {
        if(!isLoggedIn || currentUserRole !== 'user') { showToast('⚠️ ইউজার হিসেবে লগইন করুন', 'error'); return; }
        const amount = parseInt(document.getElementById('rechargeAmount').value);
        if(!amount || amount <= 0) { showToast('সঠিক টাকা লিখুন', 'error'); return; }
        try {
            await db.runTransaction(async (t) => {
                const doc = await t.get(db.collection('users').doc(currentUserId));
                t.update(db.collection('users').doc(currentUserId), { wallet: (doc.data().wallet||0) + amount });
            });
            showToast('✅ '+amount+' টাকা রিচার্জ হয়েছে!', 'success');
        } catch(e) { showToast('❌ রিচার্জ ব্যর্থ', 'error'); }
    };
    window.withdrawMoney = async function() {
        if(!isLoggedIn || currentUserRole !== 'provider') { showToast('⚠️ প্রোভাইডার হিসেবে লগইন করুন', 'error'); return; }
        const amount = parseInt(document.getElementById('withdrawAmount').value);
        if(!amount || amount <= 0) { showToast('সঠিক টাকা লিখুন', 'error'); return; }
        try {
            await db.runTransaction(async (t) => {
                const doc = await t.get(db.collection('providers').doc(currentUserId));
                if((doc.data().wallet||0) < amount) throw new Error('পর্যাপ্ত টাকা নেই');
                t.update(db.collection('providers').doc(currentUserId), { wallet: (doc.data().wallet||0) - amount });
            });
            showToast('✅ '+amount+' টাকা উইথড্র হয়েছে!', 'success');
        } catch(e) { showToast('❌ উইথড্র ব্যর্থ: '+e.message, 'error'); }
    };
    window.makeCall = function(phone) {
        if(!phone) return;
        let f = phone.trim();
        if(f.startsWith('0')) f = '88'+f; else if(!f.startsWith('88')) f='88'+f;
        window.location.href = 'tel:'+f;
    };
    window.navigateTo = function(page) { if(isLoggedIn && currentUserRole === 'user') goToPage(page); else showToast('⚠️ লগইন করুন', 'error'); };
    window.navigateToProvider = function(page) { if(isLoggedIn && currentUserRole === 'provider') goToPage(page); else showToast('⚠️ লগইন করুন', 'error'); };
    window.openCategory = function(cat) {
        if(!isLoggedIn) { showToast('⚠️ লগইন করুন', 'error'); return; }
        showToast('📍 '+cat+' খুঁজছেন...', 'warning');
        goToPage('page-user-category');
        document.getElementById('category-title').textContent = '📍 '+cat;
        document.getElementById('category-sub').textContent = 'আপনার কাছাকাছি '+cat+' প্রোভাইডার';
    };
    window.searchLocation = function() {
        const input = document.getElementById('userLocationInput').value;
        if(!input) { showToast('লোকেশন দিন', 'error'); return; }
        showToast('📍 '+input+' খুঁজছি...', 'warning');
    };
    window.filterDistance = function(dist, e) {
        document.querySelectorAll('#distanceFilter button').forEach(b => b.classList.remove('active'));
        if(e) e.target.classList.add('active');
        showToast('দূরত্ব: '+dist+' কিমি', 'success');
    };
    window.bookProvider = function(name, category, id) {
        if(!isLoggedIn || currentUserRole !== 'user') { showToast('⚠️ ইউজার লগইন করুন', 'error'); return; }
        showToast('✅ '+name+' কে বুকিং করা হয়েছে!', 'success');
    };
    window.acceptBooking = function(id) { showToast('✅ বুকিং গ্রহণ করা হয়েছে', 'success'); };
    window.rejectBooking = function(id) { showToast('❌ বুকিং বাতিল করা হয়েছে', 'error'); };
    window.verifyAdmin = function() {
        const pwd = document.getElementById('adminPassword').value;
        if(pwd === 'admin123') { goToPage('page-admin-dashboard'); document.getElementById('adminError').textContent = ''; }
        else { document.getElementById('adminError').textContent = '❌ ভুল পাসওয়ার্ড!'; }
    };
    window.logoutAdmin = function() { document.getElementById('adminPassword').value = ''; goToPage('page-role'); };
    window.downloadReport = function() { showToast('📄 রিপোর্ট ডাউনলোড', 'success'); };

    // Onboarding
    function startOnboarding() {
        document.getElementById('appNameDisplay').textContent = 'সেবা বাজার';
        document.getElementById('page-onboarding').classList.add('active');
        setTimeout(() => {
            document.getElementById('page-onboarding').classList.remove('active');
            document.getElementById('page-role').classList.add('active');
        }, 2000);
    }

    // Init
    window.addEventListener('load', function() {
        // Status time
        function updateTime() {
            const now = new Date();
            document.getElementById('statusTime').textContent = String(now.getHours()).padStart(2,'0')+':'+String(now.getMinutes()).padStart(2,'0');
        }
        updateTime(); setInterval(updateTime, 30000);

        // Auth state
        auth.onAuthStateChanged(async (user) => {
            if(user) {
                try {
                    const doc = await db.collection('users').doc(user.uid).get();
                    if(doc.exists) {
                        const data = doc.data();
                        currentUserId = user.uid;
                        if(data.role === 'user') {
                            currentUserRole = 'user'; isLoggedIn = true;
                            document.getElementById('bottom-nav-user').classList.add('show');
                            document.getElementById('bottom-nav-provider').classList.remove('show');
                            goToPage('page-user-home');
                            updateNav('page-user-home');
                        } else if(data.role === 'provider') {
                            const pDoc = await db.collection('providers').doc(user.uid).get();
                            if(pDoc.exists && pDoc.data().status === 'approved') {
                                currentUserRole = 'provider'; isLoggedIn = true;
                                document.getElementById('bottom-nav-provider').classList.add('show');
                                document.getElementById('bottom-nav-user').classList.remove('show');
                                goToPage('page-provider-home');
                                updateNav('page-provider-home');
                            } else {
                                await auth.signOut();
                                showToast('⏳ অনুমোদনের অপেক্ষায়', 'warning');
                                goToPage('page-role');
                            }
                        }
                    } else { await auth.signOut(); goToPage('page-role'); }
                } catch(e) { console.error(e); goToPage('page-role'); }
            } else {
                if(window.location.hash === '#admin') {
                    document.getElementById('page-onboarding')?.classList.remove('active');
                    goToPage('page-admin-login');
                    return;
                }
                startOnboarding();
            }
        });
    });
    console.log('🚀 সেবা বাজার রেডি! OTP: 123456, Admin: admin123');
} else {
    document.body.innerHTML = '<div style="display:flex;align-items:center;justify-content:center;height:100vh;background:#fef9e7;color:#c62828;font-size:1.2rem;padding:20px;text-align:center;"><div><i class="fas fa-exclamation-triangle" style="font-size:3rem;"></i><p style="margin-top:16px;">❌ Firebase লোড হয়নি!<br>ইন্টারনেট চেক করুন।</p></div></div>';
}
</script>
</body>
</html>